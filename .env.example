# ── Core app ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=https://caresaath.onrender.com
CORS_ORIGINS=https://caresaath.onrender.com
# Optional shared gate (empty = off). Must be 24+ chars when set; the web app
# sends the same value as NEXT_PUBLIC_API_ACCESS_KEY.
API_ACCESS_KEY=
# Global request cap; OTP routes keep their own stricter per-phone throttle.
THROTTLE_LIMIT=600
THROTTLE_TTL_MS=60000

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL=postgresql://caresaath:caresaath@localhost:15432/caresaath
DATABASE_POOL_MAX=20
DATABASE_KEEPALIVE_MS=25000

# ── Redis / cache ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:16379
SEARCH_CACHE_TTL_SECONDS=30

# ── Auth (JWT) ──────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ── Encryption keys (field-level, at rest) ──────────────────────────────────
PAYOUT_ENCRYPTION_KEY=change-me
CNIC_ENCRYPTION_KEY=change-me
MEDICAL_ENCRYPTION_KEY=change-me

# ── File storage (Cloudinary) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=caresaath

# ── Email (SMTP) ────────────────────────────────────────────────────────────
# Production: GoDaddy - 465 = implicit TLS (SMTP_SECURE defaults true),
# 587 = STARTTLS. Local dev: Mailpit on port 11025 (plaintext, no auth).
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
# Leave unset to infer from the port; never set false on 465 (sends hang).
SMTP_SECURE=
SMTP_REQUIRE_TLS=
SMTP_USERNAME=info@caresaath.com
SMTP_PASSWORD=<your-godaddy-email-password>
# Must be the authenticated mailbox - GoDaddy rejects any other From.
SMTP_FROM_EMAIL=info@caresaath.com
SMTP_FROM_NAME=CareSaath

# ── OTP ─────────────────────────────────────────────────────────────────────
# OTPs are also mirrored to this ops inbox for support/testing. Codes are never
# written to application logs.
OTP_MIRROR_EMAIL=
OTP_TTL_SECONDS=300
CHECKIN_OTP_TTL_SECONDS=600

# ── Bookings & caregiver rules ──────────────────────────────────────────────
BOOKING_RESPOND_WINDOW_MINUTES=60
BOOKING_CANCEL_NOTICE_MINUTES=0
# Immediate (ASAP) bookings: shorter window + proximity requirement.
BOOKING_IMMEDIATE_RESPOND_WINDOW_MINUTES=10
BOOKING_IMMEDIATE_MAX_DISTANCE_METERS=5000
BOOKING_IMMEDIATE_AVG_SPEED_KMH=20
# Available-now caregivers need a GPS fix newer than this.
CAREGIVER_AVAILABLE_NOW_MAX_FIX_AGE_MINUTES=10
# Booking-expiry sweep interval (minutes).
BOOKING_EXPIRY_INTERVAL_MINUTES=5
# Strikes (declines, late arrivals, no-shows) before auto-suspension.
CAREGIVER_STRIKE_THRESHOLD=3

# ── Visits & live tracking ──────────────────────────────────────────────────
VISIT_LATE_ARRIVAL_GRACE_MINUTES=15
# GPS-vs-address check-in radius in metres; 0 disables the check.
VISIT_GEOFENCE_RADIUS_METERS=300
# 1 = payment verified before completion; 0 disables.
VISIT_REQUIRE_PAYMENT_BEFORE_COMPLETE=1
VISIT_LOCATION_TTL_SECONDS=60
VISIT_LOCATION_AVERAGE_SPEED_KMH=25
# Max age of the ambient fix used for a fallback ETA before live fixes arrive.
VISIT_LOCATION_FALLBACK_MAX_AGE_MINUTES=15
# ETA shown while EN_ROUTE before any GPS fix arrives.
VISIT_DEFAULT_ETA_MINUTES=25

# ── Data retention ──────────────────────────────────────────────────────────
RETENTION_ENABLED=true
RETENTION_INTERVAL_MINUTES=60
RETENTION_NOTIFICATION_DAYS=90

# ── Payments ────────────────────────────────────────────────────────────────
# Required in production; signs "<gatewayRef>:<status>" (HMAC-SHA256).
PAYMENT_WEBHOOK_SECRET=
# Abandon gateway payments still pending after this long.
PAYMENT_PENDING_TTL_MINUTES=30
# Hosted checkout base URL (gateway integration TBD).
PAYMENT_CHECKOUT_BASE_URL=https://checkout.caresaath.pk
# Interval for the Stripe pending-payment reconcile sweep.
PAYMENT_RECONCILE_INTERVAL_MINUTES=10
# Stripe (hosted Checkout). Use sk_test_... outside production.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Signing secret for POST /api/v1/payments/webhook/stripe
# (local: stripe listen --forward-to localhost:3000/api/v1/payments/webhook/stripe)
STRIPE_WEBHOOK_SECRET=
# Stripe's ~US$0.50 minimum, in whole PKR.
STRIPE_MIN_CHARGE_PKR=140
# Where Stripe returns the customer after paying or cancelling.
PAYMENT_RETURN_URL=http://localhost:3001/payments/return

# ── Push notifications ──────────────────────────────────────────────────────
# Firebase service-account JSON on one line. Also used for phone OTP, so enable
# "Phone" sign-in. Same project as the Android app's google-services.json.
FIREBASE_ADMIN_SDK_KEY=
# Browser push: npx web-push generate-vapid-keys (off until both keys are set).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@caresaath.com

# ── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_from_meta
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_OTP_TEMPLATE=caresaath_otp
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEST_RECIPIENT=923001234567

# ── Chat ────────────────────────────────────────────────────────────────────
# How long a resumable upload session survives in Redis.
CHAT_UPLOAD_TTL_SECONDS=7200
# Minutes a sender may delete their message.
CHAT_DELETE_GRACE_MINUTES=60

# ── Calls (WebRTC ICE servers) ──────────────────────────────────────────────
# STUN has a public default; TURN activates only when both values are set.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
