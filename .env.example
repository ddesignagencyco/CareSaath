DATABASE_URL=postgresql://caresaath:caresaath@localhost:15432/caresaath
REDIS_URL=redis://localhost:16379
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=caresaath

# Email (SMTP) Configuration
# GoDaddy Secure Server - Tested and working
# SMTP Host: smtpout.secureserver.net (Port 465 SSL)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USERNAME=info@caresaath.com
SMTP_PASSWORD=<your-godaddy-email-password>
SMTP_FROM_EMAIL=info@caresaath.com
SMTP_FROM_NAME=CareSaath
OTP_TTL_SECONDS=300
CHECKIN_OTP_TTL_SECONDS=600
BOOKING_RESPOND_WINDOW_MINUTES=60
BOOKING_CANCEL_NOTICE_MINUTES=0
# Immediate (ASAP) bookings: shorter response window + proximity requirement
BOOKING_IMMEDIATE_RESPOND_WINDOW_MINUTES=10
BOOKING_IMMEDIATE_MAX_DISTANCE_METERS=5000
# How often (minutes) the booking-expiry sweep auto-declines bookings past respondBy
BOOKING_EXPIRY_INTERVAL_MINUTES=5
# Strikes (declined bookings, late arrivals, no-shows) before auto-suspension
CAREGIVER_STRIKE_THRESHOLD=3
VISIT_LATE_ARRIVAL_GRACE_MINUTES=15
RETENTION_ENABLED=true
RETENTION_INTERVAL_MINUTES=60
RETENTION_NOTIFICATION_DAYS=90
SEARCH_CACHE_TTL_SECONDS=30
WHATSAPP_ENABLED=false
PAYOUT_ENCRYPTION_KEY=change-me
CNIC_ENCRYPTION_KEY=change-me
MEDICAL_ENCRYPTION_KEY=change-me

# Payment gateway webhook signing (HMAC-SHA256 of "<gatewayRef>:<status>"); required in production
PAYMENT_WEBHOOK_SECRET=

# Stripe (card payments via hosted Checkout). Use test keys (sk_test_...) outside production.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook endpoint -> POST /api/v1/payments/webhook/stripe
# (local: run `stripe listen --forward-to localhost:3000/api/v1/payments/webhook/stripe`)
STRIPE_WEBHOOK_SECRET=
# Stripe rejects checkouts below ~US$0.50; minimum card charge in whole PKR
STRIPE_MIN_CHARGE_PKR=140
# Where Stripe sends the customer after paying or cancelling (the frontend page)
PAYMENT_RETURN_URL=http://localhost:3001/payments/return

# Live GPS tracking while a visit is EN_ROUTE
VISIT_LOCATION_TTL_SECONDS=60
VISIT_LOCATION_AVERAGE_SPEED_KMH=25

# Resumable chat media uploads: how long an upload session survives in Redis
CHAT_UPLOAD_TTL_SECONDS=7200

# WebRTC ICE servers for in-app calls (GET /realtime/ice-servers). STUN defaults to a
# public server; TURN (needed for production NAT traversal) is included only once both
# are set, using coturn's REST API time-limited shared-secret credential scheme.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
