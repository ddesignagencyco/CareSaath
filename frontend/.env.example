# NestJS API base URL (backend listens on PORT, default 3000)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Firebase web config for phone-auth SMS OTP (optional).
# Login/signup send the OTP via Firebase (Google SMS) and the backend verifies the
# resulting ID token at POST /auth/firebase/verify ONLY when NEXT_PUBLIC_FIREBASE_ENABLED
# is "true" AND the config below is set. Otherwise the app falls back to the existing
# backend email/dev-OTP flow (nothing else changes).
# Explicit on/off switch so having the config present does NOT auto-fire real SMS.
NEXT_PUBLIC_FIREBASE_ENABLED=false
# Values come from Firebase console → Project settings → Your apps (Web app).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
