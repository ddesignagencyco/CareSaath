# ── API ─────────────────────────────────────────────────────────────────────
# NestJS API base URL (backend listens on PORT, default 3000).
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Must match the backend API_ACCESS_KEY (24+ chars). Empty = gate off.
NEXT_PUBLIC_API_ACCESS_KEY=

# ── Firebase phone-auth OTP (optional) ──────────────────────────────────────
# Set ENABLED=true and fill the config to send real SMS; otherwise login falls
# back to the backend email/dev OTP flow.
NEXT_PUBLIC_FIREBASE_ENABLED=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
